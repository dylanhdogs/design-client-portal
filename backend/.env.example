BACKUP_DIR="backups"
MANIFEST_DIR="manifests"
BACKUP_ENCRYPTION_KEY="replace-with-a-separately-managed-random-key-of-at-least-32-characters"
BACKUP_ENABLED=true
BACKUP_SCHEDULER_MODE=internal
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26
