HOST="0.0.0.0"
PORT=4000
APP_INSTANCE_COUNT=1
TRUST_PROXY_HOPS=1
STAGING_MODE=false
UPLOAD_DIR="uploads"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
PRIVACY_NOTICE_URL=""
SUPPORT_EMAIL=""
ORGANIZATION_ID=""
