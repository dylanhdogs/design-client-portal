  authorizedBy         String    @map("authorized_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  request    ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  authorizer User               @relation("PurchaseOrderAuthorizer", fields: [authorizedBy], references: [id], onDelete: Restrict)
  deliveries Delivery[]
  invoiceMatches InvoiceMatch[]

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model Delivery {
  id               String    @id @default(uuid())
  purchaseOrderId  String    @map("purchase_order_id")
  expectedAt       DateTime? @map("expected_at")
  receivedAt       DateTime? @map("received_at")
  quantityReceived Float     @map("quantity_received")
  condition        String
  inspectionStatus String    @default("PENDING") @map("inspection_status")
  inspectionNotes  String?   @map("inspection_notes")
  inspectedBy      String?   @map("inspected_by")
  inspectedAt      DateTime? @map("inspected_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inspector     User?         @relation("DeliveryInspector", fields: [inspectedBy], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([inspectionStatus])
  @@map("deliveries")
}

model Substitution {
  id                          String    @id @default(uuid())
  procurementRequestId        String    @map("procurement_request_id")
  originalSpecification       String    @map("original_specification")
  proposedSpecification       String    @map("proposed_specification")
  reason                      String
  costImpactCents             Int       @default(0) @map("cost_impact_cents")
  scheduleImpactDays          Int       @default(0) @map("schedule_impact_days")
  currencyCode                String    @default("USD") @map("currency_code")
  status                      String    @default("PENDING")
  clientAuthorizationRequired Boolean   @default(false) @map("client_authorization_required")
  requestedBy                 String    @map("requested_by")
  approvedBy                  String?   @map("approved_by")
  approvedAt                  DateTime? @map("approved_at")
  clientAuthorizedBy          String?   @map("client_authorized_by")
  clientAuthorizedAt          DateTime? @map("client_authorized_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  request          ProcurementRequest @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  requester        User               @relation("SubstitutionRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  approver         User?              @relation("SubstitutionApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  clientAuthorizer User?              @relation("SubstitutionClientAuthorizer", fields: [clientAuthorizedBy], references: [id], onDelete: SetNull)

  @@index([procurementRequestId])
  @@index([status])
  @@map("substitutions")
}

model InvoiceMatch {
  id                   String   @id @default(uuid())
  purchaseOrderId      String   @map("purchase_order_id")
  invoiceReference     String   @map("invoice_reference")
  orderedAmountCents   Int      @map("ordered_amount_cents")
  deliveredAmountCents Int      @map("delivered_amount_cents")
  invoicedAmountCents  Int      @map("invoiced_amount_cents")
  varianceAmountCents  Int      @map("variance_amount_cents")
  orderedQuantity      Float    @map("ordered_quantity")
  deliveredQuantity    Float    @map("delivered_quantity")
  currencyCode         String   @default("USD") @map("currency_code")
  status               String
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, invoiceReference])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("invoice_matches")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  message   String
  clientId  String?  @map("client_id")
  phaseId   String?  @map("phase_id")
  itemId    String?  @map("item_id")
  inquiryId String?  @map("inquiry_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId])
  @@index([userId, isRead])
  @@index([inquiryId])
  @@map("notifications")
}

model NotificationDelivery {
  id                String    @id @default(uuid())
  notificationId    String    @map("notification_id")
  channel           String    @default("EMAIL")
  destination       String
  status            String    @default("PENDING")
  attemptCount      Int       @default(0) @map("attempt_count")
  nextAttemptAt     DateTime? @map("next_attempt_at")
  lastAttemptAt     DateTime? @map("last_attempt_at")
  sentAt            DateTime? @map("sent_at")
  lastError         String?   @map("last_error")
  providerMessageId String?   @map("provider_message_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model AutomationSuggestion {
  id               String    @id @default(uuid())
  organizationId   String?   @map("organization_id")
  projectId        String?   @map("project_id")
  inquiryId        String?   @map("inquiry_id")
  type             String
  sourceEntityType String    @map("source_entity_type")
  sourceEntityId   String    @map("source_entity_id")
  title            String
  suggestionJson   String    @map("suggestion_json")
  rationale        String
  status           String    @default("PENDING_REVIEW")
  generatedBy      String    @default("RULE_ENGINE") @map("generated_by")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewComment    String?   @map("review_comment")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project  PoolProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("AutomationSuggestionReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([type, sourceEntityType, sourceEntityId])
  @@index([projectId, status])
  @@index([inquiryId, status])
  @@index([organizationId, status])
  @@map("automation_suggestions")
}

model AutomationRun {
  id           String    @id @default(uuid())
  type         String
  status       String    @default("RUNNING")
  triggeredBy  String?   @map("triggered_by")
  attemptCount Int       @default(1) @map("attempt_count")
  metricsJson  String?   @map("metrics_json")
  errorMessage String?   @map("error_message")
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  trigger User? @relation("AutomationRunTrigger", fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([type, startedAt])
  @@map("automation_runs")
}

model LegalHold {
  id         String    @id @default(uuid())
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  reason     String
  active     Boolean   @default(true)
  setBy      String    @map("set_by")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  setter User @relation("LegalHoldSetter", fields: [setBy], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, active])
  @@map("legal_holds")
}

model OperationalAlert {
  id             String    @id @default(uuid())
  category       String
  severity       String    @default("WARNING")
  status         String    @default("OPEN")
  requestId      String?   @map("request_id")
  message        String
  metadataJson   String?   @map("metadata_json")
  acknowledgedAt DateTime? @map("acknowledged_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([category, status, createdAt])
  @@index([requestId])
  @@map("operational_alerts")
}

model ClientStatusReport {
  id                 String    @id @default(uuid())
  organizationId     String?   @map("organization_id")
  clientId           String    @map("client_id")
  projectId          String?   @map("project_id")
  inquiryId          String?   @map("inquiry_id")
  asOfDate           DateTime  @map("as_of_date")
  displayTimeZone    String    @map("display_time_zone")
  generatedAt        DateTime  @default(now()) @map("generated_at")
  generatedBy        String    @map("generated_by")
  sourceWatermark    DateTime  @map("source_watermark")
  sourceFingerprint  String    @map("source_fingerprint")
  reportVersion      Int       @default(1) @map("report_version")
  generationMode     String    @default("FACTS_ONLY") @map("generation_mode")
  overallState       String    @map("overall_state")
  factSnapshotJson   String    @map("fact_snapshot_json")
  narrativeJson      String?   @map("narrative_json")
  modelName           String?   @map("model_name")
  promptVersion       String?   @map("prompt_version")
  estimatedCostCents Int?      @map("estimated_cost_cents")
  status             String    @default("COMPLETE")
  warningSummary     String?   @map("warning_summary")
  createdAt          DateTime  @default(now()) @map("created_at")

  client    Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   PoolProject?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inquiry   Inquiry?                   @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  generator User                       @relation("ClientStatusReportGenerator", fields: [generatedBy], references: [id], onDelete: Restrict)
  sources   ClientStatusReportSource[]

  @@index([clientId, generatedAt])
  @@index([projectId, generatedAt])
  @@index([inquiryId, generatedAt])
  @@index([organizationId, generatedAt])
  @@index([sourceFingerprint])
  @@map("client_status_reports")
}

model ClientStatusReportSource {
  id              String   @id @default(uuid())
  reportId        String   @map("report_id")
  sourceType      String   @map("source_type")
  sourceId        String   @map("source_id")
  sourceUpdatedAt DateTime @map("source_updated_at")
  section         String

  report ClientStatusReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sourceType, sourceId, section])
  @@index([reportId])
  @@index([sourceType, sourceId])
  @@map("client_status_report_sources")
}
