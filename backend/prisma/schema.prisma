generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  role              String    @default("CLIENT")
  name              String
  clientId          String?   @map("client_id")
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  sessionVersion    Int       @default(0) @map("session_version")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  consultations                  Consultation[]
  documents                      Document[]
  communications                 Communication[]
  communicationThreads           CommunicationThread[] @relation("CommunicationThreadCreator")
  poolNotes                      PoolNote[]
  activityLogs                   ActivityLog[]
  notifications                  Notification[]
  ownedInquiries                 Inquiry[]               @relation("InquiryOwner")
  ownedStages                    LifecycleStage[]        @relation("StageOwner")
  reviewedStages                 LifecycleStage[]        @relation("StageReviewer")
  ownedWorkItems                 WorkItem[]              @relation("WorkItemOwner")
  reviewedWorkItems              WorkItem[]              @relation("WorkItemReviewer")
  createdWorkItems               WorkItem[]              @relation("WorkItemCreator")
  requestedDecisions             Decision[]              @relation("DecisionRequester")
  assignedDecisions              Decision[]              @relation("DecisionMaker")
  approvals                      Approval[]              @relation("ApprovalApprover")
  reviewedGates                  ProjectGate[]           @relation("GateReviewer")
  approvedGates                  ProjectGate[]           @relation("GateApprover")
  projectAssignments             ProjectAssignment[]
  createdDesignVersions          DesignVersion[]         @relation("DesignVersionCreator")
  approvedDesignVersions         DesignVersion[]         @relation("DesignVersionApprover")
  createdScopeVersions           ScopeVersion[]          @relation("ScopeVersionCreator")
  approvedScopeVersions          ScopeVersion[]          @relation("ScopeVersionApprover")
  evidenceLinks                  EvidenceLink[]          @relation("EvidenceCreator")
  ownedComplianceRequirements    ComplianceRequirement[] @relation("ComplianceOwner")
  reviewedComplianceRequirements ComplianceRequirement[] @relation("ComplianceReviewer")
  ownedComplianceExceptions      ComplianceException[]   @relation("ComplianceExceptionOwner")
  approvedComplianceExceptions   ComplianceException[]   @relation("ComplianceExceptionApprover")
  ownedPreconstructionItems      PreconstructionItem[]    @relation("PreconstructionItemOwner")
  reviewedPreconstructionItems   PreconstructionItem[]    @relation("PreconstructionItemReviewer")
  readinessReviews               ReadinessReview[]        @relation("ReadinessReviewer")
  ownedReadinessExceptions       ReadinessException[]     @relation("ReadinessExceptionOwner")
  approvedReadinessExceptions    ReadinessException[]     @relation("ReadinessExceptionApprover")
  ownedProcurementRequests       ProcurementRequest[]     @relation("ProcurementRequestOwner")
  selectedProcurementQuotes      Quote[]                  @relation("QuoteSelector")
  authorizedPurchaseOrders       PurchaseOrder[]          @relation("PurchaseOrderAuthorizer")
  inspectedDeliveries            Delivery[]               @relation("DeliveryInspector")
  requestedSubstitutions         Substitution[]           @relation("SubstitutionRequester")
  approvedSubstitutions          Substitution[]           @relation("SubstitutionApprover")
  clientAuthorizedSubstitutions  Substitution[]           @relation("SubstitutionClientAuthorizer")
  reviewedAutomationSuggestions AutomationSuggestion[]   @relation("AutomationSuggestionReviewer")
  automationRuns                AutomationRun[]          @relation("AutomationRunTrigger")
  legalHolds                    LegalHold[]               @relation("LegalHoldSetter")
  generatedClientStatusReports ClientStatusReport[]      @relation("ClientStatusReportGenerator")
  updatedInquiryCriterionStates InquiryCriterionState[] @relation("InquiryCriterionStateUpdater")
  inquiryCriterionStateAudits InquiryCriterionStateAudit[] @relation("InquiryCriterionStateAuditActor")
  createdInquiryActivities InquiryActivity[] @relation("InquiryActivityActor")
  reviewedInquiryHandoffs InquiryHandoffReview[] @relation("InquiryHandoffReviewer")
  createdInquiryEvidence InquiryEvidence[] @relation("InquiryEvidenceActor")
  recordedInquiryDispositions Inquiry[] @relation("InquiryDispositionRecorder")
  reviewedInquiryDispositions Inquiry[] @relation("InquiryDispositionReviewer")
  clientInquiryDispositions Inquiry[] @relation("InquiryDispositionClientUser")
  client                         Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  company   String?
  email     String?
  phone     String?
  address   String?
  status    String    @default("LEAD")
  notes     String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  consultations  Consultation[]
  documents      Document[]
  communications Communication[]
  communicationThreads CommunicationThread[]
  poolProject    PoolProject?
  users          User[]
  invitations    Invitation[]
  properties     Property[]
  inquiries      Inquiry[]
  statusReports  ClientStatusReport[]
  inquiryActivities InquiryActivity[]

  @@map("clients")
}

model Consultation {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  inquiryId String?   @map("inquiry_id")
  title     String
  activityType String @default("SITE_MEETING") @map("activity_type")
  meetingMode String? @map("meeting_mode")
  subject   String?
  date      DateTime
  endAt     DateTime? @map("end_at")
  notes     String?
  status    String    @default("SCHEDULED")
  outcome   String?
  participants String?
  internalFollowers String? @map("internal_followers")
  nextAction String? @map("next_action")
  nextActionDueAt DateTime? @map("next_action_due_at")
  cancellationReason String? @map("cancellation_reason")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiry   Inquiry?   @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([clientId])
  @@index([userId])
  @@index([inquiryId])
  @@map("consultations")
}

model Document {
  id             String    @id @default(uuid())
  clientId       String    @map("client_id")
  consultationId String?   @map("consultation_id")
  inquiryId      String?   @map("inquiry_id")
  userId         String    @map("user_id")
  filename       String
  originalName   String    @map("original_name")
  mimeType       String    @map("mime_type")
  size           Int
  description    String?
  retentionUntil DateTime? @map("retention_until")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultation  Consultation?  @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  inquiry       Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceLink[]
  inquiryEvidenceLinks InquiryEvidence[]
  inquiryActivityDocuments InquiryActivityDocument[]

  @@index([clientId])
  @@index([consultationId])
  @@index([inquiryId])
  @@index([userId])
  @@map("documents")
}

model Communication {
  id        String    @id @default(uuid())
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  threadId  String?   @map("thread_id")
  type      String    @default("EMAIL")
  subject   String?
  body      String
  direction String    @default("OUTBOUND")
  date      DateTime  @default(now())
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread CommunicationThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([threadId])
  @@map("communications")
}

model CommunicationThread {
  id          String    @id @default(uuid())
  clientId    String    @map("client_id")
  createdById String?   @map("created_by_id")
  title       String
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("CommunicationThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  communications Communication[]

  @@index([clientId])
  @@index([createdById])
  @@map("communication_threads")
}

model PoolProject {
  id                    String   @id @default(uuid())
  clientId              String   @unique @map("client_id")
  poolType              String?  @map("pool_type")
  poolShape             String?  @map("pool_shape")
  dimensions            String?
  estimatedBudget       String?  @map("estimated_budget")
  notes                 String?
  currentPhase          Int      @default(1) @map("current_phase")
  status                String   @default("INTAKE")
  workflowEnabled       Boolean  @default(false) @map("workflow_enabled")
  currentLifecycleStage String?  @map("current_lifecycle_stage")
  workflowVersion       Int      @default(0) @map("workflow_version")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phases                 ProjectPhase[]
  poolNotes              PoolNote[]
  inquiries              Inquiry[]
  lifecycleStages        LifecycleStage[]
  workItems              WorkItem[]
  decisions              Decision[]
  approvals              Approval[]
  gates                  ProjectGate[]
  assignments            ProjectAssignment[]
  designVersions         DesignVersion[]
  scopeVersions          ScopeVersion[]
  evidenceLinks          EvidenceLink[]
  complianceRequirements ComplianceRequirement[]
  complianceExceptions   ComplianceException[]
  preconstructionItems   PreconstructionItem[]
  readinessReviews       ReadinessReview[]
  readinessExceptions    ReadinessException[]
  procurementRequests    ProcurementRequest[]
  automationSuggestions AutomationSuggestion[]
  statusReports         ClientStatusReport[]

  @@map("pool_projects")
}

model ProjectPhase {
  id            String    @id @default(uuid())
  projectId     String    @map("project_id")
  name          String
  displayName   String    @map("display_name")
  order         Int
  status        String    @default("NOT_STARTED")
  description   String?
  startDate     DateTime? @map("start_date")
  completedDate DateTime? @map("completed_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project        PoolProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklistItems ChecklistItem[]

  @@index([projectId])
  @@map("project_phases")
}

model ChecklistItem {
  id                 String    @id @default(uuid())
  phaseId            String    @map("phase_id")
  description        String
  clientActionRequired Boolean @default(false) @map("client_action_required")
  isCompleted        Boolean   @default(false) @map("is_completed")
  completedAt        DateTime? @map("completed_at")
  completedBy        String?   @map("completed_by")
  verificationStatus String    @default("NOT_SUBMITTED") @map("verification_status")
  submittedAt        DateTime? @map("submitted_at")
  submittedBy        String?   @map("submitted_by")
  verifiedAt         DateTime? @map("verified_at")
  verifiedBy         String?   @map("verified_by")
  rejectionReason    String?   @map("rejection_reason")
  order              Int
  createdAt          DateTime  @default(now()) @map("created_at")

  phase ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId])
  @@map("checklist_items")
}

model PoolNote {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  project PoolProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("pool_notes")
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  clientId   String    @map("client_id")
  token      String    @unique
  status     String    @default("PENDING")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([token])
  @@map("invitations")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  details     String?
  requestId   String?  @map("request_id")
  beforeState String?  @map("before_state")
  afterState  String?  @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

model Property {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  clientId       String   @map("client_id")
  address        String
  city           String?
  state          String?
  postalCode     String?  @map("postal_code")
  jurisdiction   String?
  hoaName        String?  @map("hoa_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  inquiries              Inquiry[]
  complianceRequirements ComplianceRequirement[]

  @@index([clientId])
  @@index([organizationId, clientId])
  @@map("properties")
}

model Inquiry {
  id                  String    @id @default(uuid())
  organizationId      String?   @map("organization_id")
  clientId            String    @map("client_id")
  propertyId          String?   @map("property_id")
  projectId           String?   @map("project_id")
  source              String?
  referralName        String?   @map("referral_name")
  description         String?
  objectives          String?
  preliminaryScope    String?   @map("preliminary_scope")
  designInspirations  String?   @map("design_inspirations")
  budgetExpectation   String?   @map("budget_expectation")
  desiredTiming       String?   @map("desired_timing")
  discoveryData       String?   @map("discovery_data")
  discoveryCompletedAt DateTime? @map("discovery_completed_at")
  siteAssessment      String?   @map("site_assessment")
  siteAssessmentData  String?   @map("site_assessment_data")
  romAmount           String?   @map("rom_amount")
  proposalNarrative   String?   @map("proposal_narrative")
  romProposalDetails  String?   @map("rom_proposal_details")
  proposalProvidedAt  DateTime? @map("proposal_provided_at")
  proposalClientResponse String? @map("proposal_client_response")
  romStatus           String?   @map("rom_status")
  romDecisionAt       DateTime? @map("rom_decision_at")
  romApprovedBy       String?   @map("rom_approved_by")
  designAgreementStatus String? @map("design_agreement_status")
  designAgreementAcceptedAt DateTime? @map("design_agreement_accepted_at")
  designAgreementAcceptedBy String? @map("design_agreement_accepted_by")
  handoffSummary      String?   @map("handoff_summary")
  handoffApprovedAt   DateTime? @map("handoff_approved_at")
  handoffApprovedBy   String?   @map("handoff_approved_by")
  complianceVerificationStatus String? @map("compliance_verification_status")
  complianceVerificationCheckedAt DateTime? @map("compliance_verification_checked_at")
  complianceVerificationSource String? @map("compliance_verification_source")
  complianceVerificationCategories String? @map("compliance_verification_categories")
  complianceVerificationLinks String? @map("compliance_verification_links")
  complianceVerificationReviewedBy String? @map("compliance_verification_reviewed_by")
  complianceVerificationReviewedAt DateTime? @map("compliance_verification_reviewed_at")
  complianceVerificationNotes String? @map("compliance_verification_notes")
  qualificationStatus String    @default("NEW") @map("qualification_status")
  intakeRevision      Int       @default(1) @map("intake_revision")
  legacyReviewStatus   String    @default("PENDING") @map("legacy_review_status")
  ownerId             String?   @map("owner_id")
  nextAction          String?   @map("next_action")
  nextActionDueAt     DateTime? @map("next_action_due_at")
  declineReason       String?   @map("decline_reason")
  clientDisposition String? @map("client_disposition")
  clientDispositionComment String? @map("client_disposition_comment")
  clientDispositionSource String? @map("client_disposition_source")
  clientDispositionAt DateTime? @map("client_disposition_at")
  clientDispositionRecordedBy String? @map("client_disposition_recorded_by")
  clientDispositionClientUserId String? @map("client_disposition_client_user_id")
  clientDispositionEvidenceActivityId String? @map("client_disposition_evidence_activity_id")
  clientDispositionReviewStatus String? @map("client_disposition_review_status")
  clientDispositionReviewedAt DateTime? @map("client_disposition_reviewed_at")
  clientDispositionReviewedBy String? @map("client_disposition_reviewed_by")
  romPreviewSnapshot String? @map("rom_preview_snapshot")
  romPreviewHash String? @map("rom_preview_hash")
  romPreviewRevision Int? @map("rom_preview_revision")
  romPreviewSavedAt DateTime? @map("rom_preview_saved_at")
  convertedAt         DateTime? @map("converted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  project       PoolProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  owner         User?          @relation("InquiryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  consultations Consultation[]
  documents     Document[]
  workItems     WorkItem[]
  statusReports ClientStatusReport[]
  complianceResearchJobs ComplianceResearchJob[]
  savedComplianceLinks InquiryComplianceLink[]
  criterionStates InquiryCriterionState[]
  criterionStateAudits InquiryCriterionStateAudit[]
  activities InquiryActivity[]
  evidence InquiryEvidence[]
  handoffReviews InquiryHandoffReview[]
  dispositionRecorder User? @relation("InquiryDispositionRecorder", fields: [clientDispositionRecordedBy], references: [id], onDelete: SetNull)
  dispositionReviewer User? @relation("InquiryDispositionReviewer", fields: [clientDispositionReviewedBy], references: [id], onDelete: SetNull)
  dispositionClientUser User? @relation("InquiryDispositionClientUser", fields: [clientDispositionClientUserId], references: [id], onDelete: SetNull)
  dispositionEvidenceActivity InquiryActivity? @relation("InquiryDispositionEvidence", fields: [clientDispositionEvidenceActivityId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([propertyId])
  @@index([projectId])
  @@index([ownerId])
  @@index([qualificationStatus])
  @@index([organizationId, qualificationStatus])
  @@index([legacyReviewStatus, qualificationStatus])
  @@map("inquiries")
}

model InquiryCriterionState {
  id          String   @id @default(uuid())
  inquiryId   String   @map("inquiry_id")
  criterionId String   @map("criterion_id")
  answerState String   @default("UNKNOWN") @map("answer_state")
  reason      String?
  source      String   @default("SYSTEM")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  updater   User?   @relation("InquiryCriterionStateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  audits    InquiryCriterionStateAudit[]

  @@unique([inquiryId, criterionId])
  @@index([criterionId, answerState])
  @@index([inquiryId])
  @@map("inquiry_criterion_states")
}

model InquiryCriterionStateAudit {
  id               String   @id @default(uuid())
  inquiryId        String   @map("inquiry_id")
  criterionId      String   @map("criterion_id")
  criterionStateId String?  @map("criterion_state_id")
  fromAnswerState  String?  @map("from_answer_state")
  toAnswerState    String   @map("to_answer_state")
  fromReason       String?  @map("from_reason")
  toReason         String?  @map("to_reason")
  source           String
  actorId          String?  @map("actor_id")
  workflowVersion  Int      @map("workflow_version")
  createdAt        DateTime @default(now()) @map("created_at")

  inquiry        Inquiry                @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  criterionState InquiryCriterionState? @relation(fields: [criterionStateId], references: [id], onDelete: SetNull)
  actor          User?                  @relation("InquiryCriterionStateAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inquiryId, createdAt])
  @@index([criterionId, createdAt])
  @@map("inquiry_criterion_state_audits")
}

model InquiryActivity {
  id String @id @default(uuid())
  inquiryId String @map("inquiry_id")
  clientId String @map("client_id")
  actorId String? @map("actor_id")
  origin String
  sourceEventId String? @map("source_event_id")
  channel String
  direction String
  contactPerson String? @map("contact_person")
  occurredAt DateTime @map("occurred_at")
  organizationTimezone String @default("America/Phoenix") @map("organization_timezone")
  summary String
  outcomeCode String @map("outcome_code")
  outcomeDetail String? @map("outcome_detail")
  clientDispositionValue String? @map("client_disposition_value")
  followUpWorkItemId String? @map("follow_up_work_item_id")
  idempotencyKey String? @map("idempotency_key")
  requestFingerprint String? @map("request_fingerprint")
  clientRomSnapshot String? @map("client_rom_snapshot")
  clientRomSnapshotHash String? @map("client_rom_snapshot_hash")
  correctionOfActivityId String? @map("correction_of_activity_id")
  correctionJson String? @map("correction_json")
  createdAt DateTime @default(now()) @map("created_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor User? @relation("InquiryActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  followUpWorkItem WorkItem? @relation("ActivityFollowUp", fields: [followUpWorkItemId], references: [id], onDelete: SetNull)
  correctionOfActivity InquiryActivity? @relation("InquiryActivityCorrections", fields: [correctionOfActivityId], references: [id], onDelete: SetNull)
  corrections InquiryActivity[] @relation("InquiryActivityCorrections")
  documents InquiryActivityDocument[]
  dispositionInquiries Inquiry[] @relation("InquiryDispositionEvidence")

  @@unique([inquiryId, actorId, idempotencyKey])
  @@unique([origin, sourceEventId])
  @@index([inquiryId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([followUpWorkItemId])
  @@map("inquiry_activities")
}

model InquiryActivityDocument {
  activityId String @map("activity_id")
  documentId String @map("document_id")
  createdAt DateTime @default(now()) @map("created_at")

  activity InquiryActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([activityId, documentId])
  @@index([documentId])
  @@map("inquiry_activity_documents")
}

model InquiryEvidence {
  id String @id @default(uuid())
  inquiryId String @map("inquiry_id")
  documentId String @map("document_id")
  category String
  actorId String @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor User @relation("InquiryEvidenceActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([inquiryId, documentId, category])
  @@index([inquiryId, category])
  @@map("inquiry_evidence")
}

model InquiryHandoffReview {
  id String @id @default(uuid())
  inquiryId String @map("inquiry_id")
  reviewerId String @map("reviewer_id")
  result String
  intakeRevision Int @map("intake_revision")
  workflowVersion Int @map("workflow_version")
  checklistSnapshot String @map("checklist_snapshot")
  checklistHash String @map("checklist_hash")
  romPreviewSnapshot String @map("rom_preview_snapshot")
  romPreviewHash String @map("rom_preview_hash")
  reason String?
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  reviewer User @relation("InquiryHandoffReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([inquiryId, intakeRevision, workflowVersion])
  @@index([reviewerId, reviewedAt])
  @@unique([inquiryId, intakeRevision, workflowVersion])
  @@map("inquiry_handoff_reviews")
}

model ComplianceResearchJob {
