FROM node:22.23.2-bookworm

ARG VITE_APP_VERSION=local
ARG VITE_APP_RELEASE_ID=local
ENV VITE_APP_VERSION=${VITE_APP_VERSION}
ENV VITE_APP_RELEASE_ID=${VITE_APP_RELEASE_ID}

WORKDIR /app
ENV DATABASE_URL=file:/tmp/signature-portal-build.db

COPY backend/package.json backend/package-lock.json ./backend/
RUN npm --prefix backend ci --include=dev

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN npm --prefix frontend ci

COPY backend ./backend
COPY frontend ./frontend

RUN npm --prefix frontend run build \
    && npm --prefix backend run build

WORKDIR /app/backend
EXPOSE 4000

CMD ["npm", "start"]
