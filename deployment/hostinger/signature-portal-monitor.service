[Unit]
Description=Verify Signature Portal production health and alert on failure
After=network-online.target signature-portal@production.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/signature-portal-production/current/deployment/hostinger/monitor-production.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock /srv/signature-portal-production/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=HOME=/tmp
