[Unit]
Description=Signature Exteriors Client Portal (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/signature-portal-%i/current/backend
EnvironmentFile=/etc/signature-portal/%i.env
Environment=HOME=/tmp
ExecStartPre=/usr/local/bin/npm run preflight
ExecStart=/usr/local/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/signature-portal-%i
UMask=0027
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
