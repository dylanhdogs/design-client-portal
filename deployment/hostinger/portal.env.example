# Production example: copy to /etc/signature-portal/production.env, set owner root:portal, and chmod 640.
# Never commit the populated production file.
NODE_ENV=production
REQUIRED_NODE_VERSION=22.23.2
HOST=127.0.0.1
PORT=4000
APP_INSTANCE_COUNT=1
TRUST_PROXY_HOPS=1
# For the systemd/Nginx package, keep loopback. Use container-network only when
# HOST=0.0.0.0 is isolated inside a private container network with no published backend port.
REVERSE_PROXY_MODE=loopback
STAGING_MODE=false

FRONTEND_URL=https://portal.example.com
CORS_ORIGINS=https://portal.example.com
APP_DOMAIN=portal.example.com
PRIVACY_NOTICE_URL=https://www.example.com/privacy
SUPPORT_EMAIL=support@example.com

DATABASE_URL=file:/srv/signature-portal-production/data/portal.db?connection_limit=1&socket_timeout=10
UPLOAD_DIR=/srv/signature-portal-production/uploads
BACKUP_DIR=/srv/signature-portal-production/backups
MANIFEST_DIR=/srv/signature-portal-production/manifests
MIN_FREE_STORAGE_BYTES=1073741824

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HEALTH_CHECK_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_HEALTH_TOKEN
JWT_EXPIRES_IN=8h
BACKUP_ENABLED=true
BACKUP_SCHEDULER_MODE=external
BACKUP_INTERVAL_HOURS=12
BACKUP_RETENTION_DAYS=30
# Set after configuring an independently owned rclone remote.
RCLONE_CONFIG=/etc/signature-portal/rclone.conf
RCLONE_BACKUP_REMOTE=provider:signature-portal-production
ALERT_WEBHOOK_URL=REPLACE_WITH_PROTECTED_MONITORING_WEBHOOK
CPU_LOAD_PER_CORE_LIMIT=2.0
MEMORY_USED_PERCENT_LIMIT=90
BACKUP_MAX_AGE_HOURS=14
CERTIFICATE_MIN_DAYS=14
ALERT_REPEAT_MINUTES=60
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_SEPARATELY_MANAGED_RANDOM_KEY

EXTERNAL_NOTIFICATION_MODE=disabled
ALLOW_UNSCANNED_COMPLEX_UPLOADS=false
DOCUMENT_RETENTION_DAYS=2555
ORGANIZATION_ID=

FEATURE_READ_ONLY_LIFECYCLE=true
FEATURE_WORKFLOW_FOUNDATION=true
FEATURE_INQUIRY=true
FEATURE_DESIGN=true
FEATURE_COMPLIANCE=true
FEATURE_PRECONSTRUCTION=true
FEATURE_PROCUREMENT=true
