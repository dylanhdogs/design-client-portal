# Copy to /etc/signature-portal/staging.env, set owner root:portal, and chmod 640.
# Use fictional data and secrets that are never reused in production.
NODE_ENV=production
REQUIRED_NODE_VERSION=22.23.2
HOST=127.0.0.1
PORT=4001
APP_INSTANCE_COUNT=1
TRUST_PROXY_HOPS=1
STAGING_MODE=true

FRONTEND_URL=https://staging-portal.example.com
CORS_ORIGINS=https://staging-portal.example.com
PRIVACY_NOTICE_URL=https://www.example.com/privacy
SUPPORT_EMAIL=support@example.com

DATABASE_URL=file:/srv/signature-portal-staging/data/portal.db?connection_limit=1&socket_timeout=10
UPLOAD_DIR=/srv/signature-portal-staging/uploads
BACKUP_DIR=/srv/signature-portal-staging/backups
MANIFEST_DIR=/srv/signature-portal-staging/manifests
MIN_FREE_STORAGE_BYTES=1073741824

JWT_SECRET=REPLACE_WITH_STAGING_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HEALTH_CHECK_TOKEN=REPLACE_WITH_STAGING_RANDOM_HEALTH_TOKEN
JWT_EXPIRES_IN=8h
BACKUP_ENABLED=true
BACKUP_SCHEDULER_MODE=internal
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_STAGING_BACKUP_KEY

EXTERNAL_NOTIFICATION_MODE=disabled
ALLOW_UNSCANNED_COMPLEX_UPLOADS=false
DOCUMENT_RETENTION_DAYS=30
ORGANIZATION_ID=

FEATURE_READ_ONLY_LIFECYCLE=true
FEATURE_WORKFLOW_FOUNDATION=true
FEATURE_INQUIRY=true
FEATURE_DESIGN=true
FEATURE_COMPLIANCE=true
FEATURE_PRECONSTRUCTION=true
FEATURE_PROCUREMENT=true
